# Generate secrets with: python scripts/generate_secrets.py
DATABASE_URL=postgresql+psycopg://melka:SET_DATABASE_PASSWORD@postgres:5432/melka
POSTGRES_PASSWORD=SET_DATABASE_PASSWORD
SERVICE_TOKEN=
KEY_HASH_SECRET=
KEY_ENCRYPTION_SECRET=
# Values go in the environment / hosting secret store, never source control.
BOT_TOKEN=
BOT_USERNAME=MelkaDLCtrialbot
ADMIN_IDS=
API_BASE_URL=http://backend:8000
PAYMENT_CARD=
PAYMENT_RECIPIENT=
# Caddy HTTPS domain. Supply a real domain pointing to your server.
API_DOMAIN=
# Trust only your reverse proxy; '*' only when backend is unreachable except through it.
FORWARDED_ALLOW_IPS=127.0.0.1
